# Copy this file to ".env" and fill in your own key values.
#   cp .env.example .env
# Never commit .env -- it holds API keys.

# LLM provider for generation (only openai is implemented)
LLM_PROVIDER=openai

# Embeddings -- build_vector_store.py and rag_query.py must agree on these two values,
# and they must match what the shipped chroma_db/ was built with. Leave them as they are.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# OpenAI key, for generating answers (https://platform.openai.com/api-keys).
# Retrieval-only runs (--show-retrieval-only) do not need it.
OPENAI_API_KEY=paste-your-key-here

# Gemini key, only for the benchmark judge in benchmark/score_eval.py
# (https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste-your-key-here
